#!/usr/bin/env python3
"""Shuffled instrumental playlists for the Omarchy bar."""
import fcntl
import json
import os
import random
import shutil
from pathlib import Path
import socket
import subprocess
import sys
import time

PACKAGE = Path(__file__).resolve().parent.parent
USER_CONFIG = Path(os.environ.get('XDG_CONFIG_HOME') or str(Path.home() / '.config')) / 'focus-music/sources.json'
CONFIG = Path(os.environ.get('FOCUS_MUSIC_CONFIG') or str(USER_CONFIG if USER_CONFIG.exists() else PACKAGE / 'data/sources.json'))
RUNTIME = Path(os.environ.get('FOCUS_MUSIC_RUNTIME') or str(Path(os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}') / 'focus-music'))
RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
SOCKET = RUNTIME / 'mpv.sock'
STATE = Path(os.environ.get('FOCUS_MUSIC_STATE') or str(Path(os.environ.get('XDG_STATE_HOME') or str(Path.home() / '.local/state')) / 'focus-music/state.json'))
STATE.parent.mkdir(parents=True, exist_ok=True)
SOURCES = json.loads(CONFIG.read_text())


def ipc_many(commands):
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(5)
        client.connect(str(SOCKET))
        with client.makefile() as stream:
            for command in commands:
                client.sendall((json.dumps({'command': command, 'request_id': 1}) + '\n').encode())
                for line in stream:
                    reply = json.loads(line)
                    if reply.get('request_id') == 1:
                        if reply.get('error') != 'success':
                            raise RuntimeError(reply.get('error'))
                        yield reply.get('data')
                        break
                else:
                    raise RuntimeError('No player response')


def ipc(command):
    return next(ipc_many([command]))


def prop(name):
    return ipc(['get_property', name])


def state():
    for path in (STATE, RUNTIME / 'state.json'):
        try:
            return json.loads(path.read_text())
        except (OSError, ValueError):
            pass
    return {'genre': 'lofi-hiphop', 'volume': 20}


def save(data):
    temporary = STATE.with_suffix('.tmp')
    temporary.write_text(json.dumps(data))
    temporary.replace(STATE)


def notify(message):
    if shutil.which('notify-send'):
        subprocess.run(['notify-send', 'Focus music', message], check=False)
    else:
        print('Focus music: ' + message, file=sys.stderr)


def active_track(saved, position=0, playlist_index=0, path=''):
    source = SOURCES[saved['genre']]
    order = saved.get('active_order', [])
    if saved.get('catalog_version') == source['catalog_version'] and order:
        index = order[min(max(playlist_index, 0), len(order) - 1)]
        return index, source['tracks'][index]
    # Display an already-playing track accurately when upgrading the catalog.
    for i, track in enumerate(source['tracks']):
        if track['url'] == path and track['start'] <= position < track['end']:
            return i, track
    return 0, {'title': 'Choose a genre', 'artist': '', 'id': 'unknown'}


def commit(saved):
    """Consume the current track and earlier entries; genre changes never resume."""
    source = SOURCES[saved['genre']]
    order = saved.get('active_order', [])
    try:
        saved['volume'] = prop('volume')
        if saved.get('catalog_version') != source['catalog_version'] or not order or prop('idle-active'):
            return
        index = prop('playlist-pos')
        if index is None or index < 0 or index >= len(order):
            return
        current = source['tracks'][order[index]]
        if prop('path') != current['url']:
            return
        saved.setdefault('decks', {})[saved['genre']] = {
            'version': source['catalog_version'], 'remaining': order[index + 1:]}
        saved['last_track_id'] = current['id']
    except (OSError, RuntimeError):
        pass


def status():
    saved = state()
    source = SOURCES[saved['genre']]
    phase = 'Stopped'
    volume = round(saved.get('volume', 20))
    position, index, path = 0, 0, ''
    try:
        idle, paused, volume, path = list(ipc_many([
            ['get_property', 'idle-active'], ['get_property', 'pause'],
            ['get_property', 'volume'], ['get_property', 'path']]))
        volume = round(volume)
        phase = 'Stopped' if idle else ('Paused' if paused else 'Playing')
        if not idle:
            try:
                position, index = list(ipc_many([['get_property', 'time-pos'], ['get_property', 'playlist-pos']]))
                position, index = position or 0, index or 0
            except RuntimeError:
                phase = 'Loading'
        elif time.time() - saved.get('started', 0) < 60:
            phase = 'Loading'
    except (OSError, RuntimeError, ValueError):
        pass
    number, track = active_track(saved, position, index, path)
    title, artist = track['title'], track['artist']
    banner = f'{artist} — {title}' if artist else title
    count = len(source['tracks'])
    return {'text': '󰎈' if phase == 'Stopped' else ('󰏤' if phase == 'Paused' else '󰎆'),
            'phase': phase, 'genre': saved['genre'], 'track': number + 1,
            'track_count': count, 'title': title, 'artist': artist,
            'track_id': track['id'], 'banner': banner,
            'tooltip': f'Focus music · {phase}\n{banner}\n{source["label"]} · {count:,} tracks · {source["duration"]/3600:.1f} hours\n{volume}% volume\nLeft: menu · Right: pause/resume · Middle: next track\nScroll: volume · ⏭: next track',
            'class': phase.lower()}


def ensure_player(saved):
    try:
        prop('idle-active')
        return
    except (OSError, RuntimeError):
        pass
    for dependency in ('mpv', 'yt-dlp'):
        if not shutil.which(dependency):
            raise RuntimeError('Missing dependency: ' + dependency)
    SOCKET.unlink(missing_ok=True)
    with (RUNTIME / 'player.log').open('w') as log:
        player = subprocess.Popen([
            'mpv', '--no-config', '--no-video', '--idle=yes', '--keep-open=no',
            '--input-terminal=no', '--terminal=no', '--loop-file=no',
            '--loop-playlist=inf', '--audio-display=no', '--ytdl-format=bestaudio/best',
            '--script-opts=ytdl_hook-ytdl_path=' + shutil.which('yt-dlp'),
            f'--volume={saved.get("volume", 20)}',
            f'--input-ipc-server={SOCKET}', '--title=Focus music'],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    for _ in range(50):
        try:
            prop('idle-active')
            return
        except (OSError, RuntimeError):
            if player.poll() is not None:
                raise RuntimeError('mpv could not start')
            time.sleep(.1)
    raise RuntimeError('Player startup timed out')


def play(genre):
    source = SOURCES[genre]
    saved = state()
    commit(saved)
    ensure_player(saved)
    deck = saved.setdefault('decks', {}).get(genre, {})
    order = deck.get('remaining', []) if deck.get('version') == source['catalog_version'] else []
    if not order:
        order = list(range(len(source['tracks'])))
    random.shuffle(order)
    if len(order) > 1 and source['tracks'][order[0]]['id'] == saved.get('last_track_id'):
        order[0], order[1] = order[1], order[0]
    generation = time.time_ns()
    saved.update(genre=genre, active_order=order, catalog_version=source['catalog_version'],
                 generation=generation, started=time.time())
    saved['decks'][genre] = {'version': source['catalog_version'], 'remaining': order}
    save(saved)
    ipc(['set_property', 'loop-file', 'no'])
    ipc(['set_property', 'loop-playlist', 'inf'])
    # File-local start/end options turn indexed mixes into real skippable tracks.
    def commands():
        for slot, index in enumerate(order):
            track = source['tracks'][index]
            options = {'start': str(track['start']), 'end': str(track['end']),
                       'force-media-title': f'{track["artist"]} — {track["title"]}'}
            yield ['loadfile', track['url'], 'replace' if slot == 0 else 'append', -1, options]
    for _ in ipc_many(commands()):
        pass
    ipc(['set_property', 'pause', False])
    return generation


def wait_ready(generation):
    for _ in range(120):
        if state().get('generation') != generation:
            return  # A later user action superseded this request.
        try:
            if not prop('idle-active') and prop('time-pos') is not None:
                return
        except (OSError, RuntimeError):
            pass
        time.sleep(.5)
    notify('Music is taking longer to load. Try skipping this track or choosing another genre.')


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else 'menu'
    if action == 'menu':
        os.execvp('omarchy-shell', ['omarchy-shell', 'shell', 'toggle', 'maxrio9.focus-music'])
    if action in ('--help', '-h', 'help'):
        print('Usage: focus-music {menu|genres|play GENRE|toggle|skip|stop|volume DELTA|status}')
        print('Streams instrumental music from YouTube. Requires mpv >= 0.38 and yt-dlp.')
        return
    if action == 'genres':
        print(json.dumps([{'value': key, 'label': source['label'],
                           'track_count': len(source['tracks']),
                           'hours': round(source['duration'] / 3600, 1)}
                          for key, source in SOURCES.items()], ensure_ascii=False))
        return
    if action == 'status':
        print(json.dumps(status(), ensure_ascii=False))
        return
    if action == 'is-playing':
        current = status()
        sys.exit(0 if current['genre'] == sys.argv[2] and current['phase'] in ('Playing', 'Loading', 'Paused') else 1)
    generation = None
    with (RUNTIME / 'control.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == 'play':
            generation = play(sys.argv[2])
        elif action == 'toggle':
            if status()['phase'] == 'Stopped':
                generation = play(state()['genre'])
            else:
                ipc(['cycle', 'pause'])
        elif action == 'skip':
            if status()['phase'] == 'Stopped' or status()['track_id'] in ('legacy', 'unknown'):
                generation = play(state()['genre'])
            else:
                ipc(['playlist-next', 'force'])
                ipc(['set_property', 'pause', False])
        elif action == 'stop':
            saved = state()
            commit(saved)
            saved['started'] = 0
            save(saved)
            try:
                ipc(['quit'])
            except OSError:
                pass
        elif action == 'volume':
            saved = state()
            try:
                current = prop('volume')
            except OSError:
                current = saved.get('volume', 20)
            saved['volume'] = max(0, min(100, current + int(sys.argv[2])))
            save(saved)
            try:
                ipc(['set_property', 'volume', saved['volume']])
            except OSError:
                pass
        else:
            raise ValueError('Unknown action: ' + action)
    if generation is not None:
        wait_ready(generation)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, KeyError, IndexError) as error:
        notify(str(error))
        print(str(error), file=sys.stderr)
        sys.exit(1)
