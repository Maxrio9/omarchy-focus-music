#!/bin/sh
set -eu
focus_root=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
cd "$focus_root"
focus_cargo_home=${CARGO_HOME:-${HOME}/.cargo}
# Keep contributor paths out of published binaries and panic locations.
export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$focus_root=/src --remap-path-prefix=$focus_cargo_home=/cargo"
if [ "$#" -eq 0 ]; then set -- x86_64-unknown-linux-musl; fi
for focus_target in "$@"; do
  case "$focus_target" in
    x86_64-unknown-linux-musl) focus_arch=x86_64 ;;
    aarch64-unknown-linux-musl) focus_arch=aarch64 ;;
    *) echo "Unsupported build target: $focus_target" >&2; exit 1 ;;
  esac
  rustup target add "$focus_target"
  cargo build --locked --release --target "$focus_target"
  mkdir -p "libexec/$focus_arch"
  cp "target/$focus_target/release/focus-music" "libexec/$focus_arch/focus-music"
  chmod 755 "libexec/$focus_arch/focus-music"
done
(
  cd libexec
  find . -mindepth 2 -maxdepth 2 -type f -name focus-music | LC_ALL=C sort | while IFS= read -r focus_file; do
    sha256sum "${focus_file#./}"
  done
) > libexec/SHA256SUMS
