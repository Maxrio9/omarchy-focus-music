#!/bin/sh
# Canonical release build: fixed paths, pinned tools, no host Cargo cache.
set -eu
focus_root=$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)
if [ "$#" -gt 1 ]; then
  echo "Usage: $0 [output-directory]" >&2
  exit 1
fi
focus_output=${1:-$focus_root/libexec}
mkdir -p "$focus_output"
focus_output=$(cd "$focus_output" && pwd)
docker build --platform linux/amd64 --tag focus-music-native-builder \
  --file "$focus_root/build/native.Dockerfile" "$focus_root/build"
docker run --rm --platform linux/amd64 --user "$(id -u):$(id -g)" \
  --mount "type=bind,source=$focus_root,target=/src,readonly" \
  --mount "type=bind,source=$focus_output,target=/out" \
  --workdir /src --env HOME=/tmp --env CARGO_HOME=/tmp/cargo \
  --env CARGO_TARGET_DIR=/tmp/target --env CARGO_INCREMENTAL=0 \
  --env SOURCE_DATE_EPOCH=0 --env FOCUS_MUSIC_NATIVE_OUTPUT=/out \
  focus-music-native-builder \
  sh scripts/build-native x86_64-unknown-linux-musl aarch64-unknown-linux-musl
